[options]
; Ejemplo orientativo. El profesor debe adaptar esta configuración a su imagen.
; La configuración real del curso se monta como /opt/odoo/odoo.conf.

admin_passwd = cambia_esta_clave_maestra
db_host = db
db_port = 5432
db_user = odoo
db_password = odoo

addons_path = /opt/odoo/src/OCB/addons,/opt/odoo/src/extra-addons

http_port = 8069
; Mantén aquí el resto de parámetros que requiera el stack del curso.
