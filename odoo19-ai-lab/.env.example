
# Ruta absoluta a los repositorios OCB/OCA en el host.
# No utilizar ~ directamente.
ODOO_SRC_HOST=~/odoo/src

# Imagen de Odoo.
ODOO_IMAGE=odoo-auto:19

# Imagen de PostgreSQL.
POSTGRES_IMAGE=postgres:17

# Configuración de PostgreSQL.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Puerto HTTP de Odoo.
ODOO_HTTP_PORT=8069

# Base de datos del laboratorio.
ODOO_DB=odoo19_lab
